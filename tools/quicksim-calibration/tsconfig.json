{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "rootDir": "../..",
    "baseUrl": "../..",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": ["../../backend/node_modules/@types"],
    "paths": { "*": ["*", "backend/node_modules/*"] }
  },
  "include": ["**/*.ts", "../../shared/**/*.ts"]
}
